#!/usr/bin/env bash
# Pre-tag check: builds the image, runs it on the local Docker daemon and exercises metrics, restarts, log shipping and shutdown.
set -u

cd "$(dirname "$0")/.."
TAG=${SMOKE_TAG:-collector:smoke}
BUILDER=${BUILDER:-}
VERSION=${VERSION:-dev}
BASE=${SMOKE_BASE_IMAGE:-alpine:3.20}
LINES=${SMOKE_LINES:-1500}
STOP_TIMEOUT=20
RUN=smoke-$$
TOKEN=smoke-$RANDOM$RANDOM
FAILS=0
TMP=$(mktemp -d "${TMPDIR:-/tmp}/collector-smoke.XXXXXX")
mkdir -p "$TMP/out" "$TMP/state"
chmod 777 "$TMP" "$TMP/out" "$TMP/state"
printf '%s' "$TOKEN" > "$TMP/token"
chmod 644 "$TMP/token"

cleanup() {
	trap '' INT TERM
	docker ps -aq --filter "label=collector.smoke=$RUN" | xargs docker rm -f >/dev/null 2>&1
	docker rmi -f "$TAG" >/dev/null 2>&1
	rm -rf "$TMP"
}
trap cleanup EXIT
trap 'echo "interrupted" >&2; exit 130' INT TERM

pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; FAILS=$((FAILS + 1)); }
# check <ok|anything> <name> [detail shown on failure]
check() { if [ "$1" = ok ]; then pass "$2"; else fail "$2${3:+ ($3)}"; fi; }
die() { fail "$1"; exit 1; }

# Polls "$@" every second until it succeeds or $WAIT seconds pass.
wait_for() {
	local n=${WAIT:-30}
	while [ "$n" -gt 0 ]; do
		"$@" && return 0
		sleep 1
		n=$((n - 1))
	done
	return 1
}

http_code() { curl -s -o /dev/null -m 5 -w '%{http_code}' "$@"; }
api() { curl -s -m 10 -H "Authorization: Bearer $TOKEN" "$URL$1"; }

# 1. Compose file validity.
if out=$(docker compose -f deploy/compose.yaml config -q 2>&1); then
	pass "compose file is valid"
else
	fail "compose file is valid: $out"
fi

# 2. Image for the host arch, loaded into the local daemon.
echo "building $TAG"
build=(docker buildx build --load --build-arg "VERSION=$VERSION" -t "$TAG")
[ -n "$BUILDER" ] && build+=(--builder "$BUILDER")
"${build[@]}" . >"$TMP/build.log" 2>&1 || { tail -n 20 "$TMP/build.log"; die "image builds"; }
pass "image builds"

# 3. Collector with the file sink, mounted as in deploy/compose.yaml.
docker run -d --name "$RUN-collector" --label "collector.smoke=$RUN" \
	--read-only --cap-drop ALL --security-opt no-new-privileges:true \
	-e COLLECTOR_HOST=smoke -e COLLECTOR_INTERVAL=2s \
	-e COLLECTOR_API__TOKEN_FILE=/run/secrets/collector-token \
	-e COLLECTOR_LOGS__ENABLED=true -e COLLECTOR_LOGS__SINK=file -e COLLECTOR_LOGS__FILE=/out/logs.jsonl \
	-p 127.0.0.1::9273 \
	-v /proc:/host/proc:ro -v /sys:/host/sys:ro -v /:/rootfs:ro,rslave \
	-v /var/run/docker.sock:/var/run/docker.sock:ro \
	-v /var/lib/docker/containers:/var/lib/docker/containers:ro \
	-v "$TMP/state:/var/lib/collector" -v "$TMP/out:/out" \
	-v "$TMP/token:/run/secrets/collector-token:ro" \
	"$TAG" >/dev/null || die "collector starts"
ADDR=$(docker port "$RUN-collector" 9273/tcp | head -n 1 | sed 's/^0\.0\.0\.0/127.0.0.1/')
URL=http://$ADDR
up() { [ "$(http_code "$URL/health")" = 200 ]; }
WAIT=30 wait_for up || { docker logs "$RUN-collector" 2>&1 | tail -n 20; die "collector starts"; }
pass "collector starts"

# 4. Test containers; they start after the collector so their logs are read from the first line.
docker run -d --name "$RUN-rotate" --label "collector.smoke=$RUN" \
	--log-opt max-size=10k --log-opt max-file=3 "$BASE" sh -c '
	i=1
	while [ $i -le '"$LINES"' ]; do
		printf "seq-%07d xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n" $i
		[ $((i % 25)) -eq 0 ] && sleep 0.25
		i=$((i + 1))
	done' >/dev/null || die "test containers start"
docker run -d --name "$RUN-restart" --label "collector.smoke=$RUN" \
	--restart on-failure:3 "$BASE" sh -c 'exit 3' >/dev/null || die "test containers start"
docker run -d --name "$RUN-pause" --label "collector.smoke=$RUN" \
	"$BASE" sleep 600 >/dev/null || die "test containers start"
sleep 3
docker pause "$RUN-pause" >/dev/null || die "test containers start"

# 5. Checks.
code=$(http_code "$URL/health")
check "$([ "$code" = 200 ] && echo ok)" "/health returns 200" "got $code"

code=$(http_code "$URL/metrics")
check "$([ "$code" = 401 ] && echo ok)" "/metrics rejects a request without the token" "got $code"

api /metrics > "$TMP/metrics.txt"
bad=$(awk '
	/^$/ { next }
	/^# (HELP|TYPE) [a-zA-Z_:][a-zA-Z0-9_:]* / { next }
	/^#/ { print "bad comment: " $0; next }
	/^[a-zA-Z_:][a-zA-Z0-9_:]*(\{.*\})? (-?[0-9][0-9.]*([eE][-+]?[0-9]+)?|NaN|[-+]Inf)( -?[0-9]+)?$/ { n++; next }
	{ print "bad line: " $0 }
	END { if (!n) print "no samples" }
' "$TMP/metrics.txt" | head -n 3)
check "$([ -z "$bad" ] && echo ok)" "/metrics is valid Prometheus text" "$bad"

restarts() {
	api /metrics | awk -v n="$RUN-restart" '/^container_restarts_total\{/ && index($0, "container=\"" n "\"") { v = $NF } END { exit !(v > 0) }'
}
WAIT=40 wait_for restarts
check "$([ $? -eq 0 ] && echo ok)" "container_restarts_total above 0 for the restarting container"

paused() { api /metrics | grep -q "^container_state{container=\"$RUN-pause\".*state=\"paused\"} 1"; }
if [ "$(docker inspect -f '{{.State.Paused}}' "$RUN-pause")" != true ]; then
	fail "paused container is reported as paused (docker pause failed)"
else
	WAIT=20 wait_for paused
	check "$([ $? -eq 0 ] && echo ok)" "container_state reports the paused container as paused"
fi

seqs() {
	grep "\"container\":\"$RUN-rotate\"" "$TMP/out/logs.jsonl" 2>/dev/null | sed -n 's/.*"_msg":"seq-0*\([0-9]*\) .*/\1/p'
}
complete() { [ "$(seqs | sort -un | wc -l | tr -d ' ')" -ge "$LINES" ]; }
WAIT=90 wait_for complete
sleep 3
seqs > "$TMP/seqs.txt"
total=$(wc -l < "$TMP/seqs.txt" | tr -d ' ')
uniq=$(sort -un "$TMP/seqs.txt" | wc -l | tr -d ' ')
missing=$(sort -un "$TMP/seqs.txt" | awk -v n="$LINES" '{ seen[$1] = 1 } END { for (i = 1; i <= n; i++) if (!seen[i]) c++; print c + 0 }')
check "$([ "$total" -eq "$LINES" ] && [ "$uniq" -eq "$LINES" ] && [ "$missing" -eq 0 ] && echo ok)" \
	"file sink has every rotated line exactly once" "expected $LINES, got $total lines, $uniq unique, $missing missing"

start=$(date +%s)
docker stop -t "$STOP_TIMEOUT" "$RUN-collector" >/dev/null 2>&1
took=$(($(date +%s) - start))
exit_code=$(docker inspect -f '{{.State.ExitCode}}' "$RUN-collector")
docker logs "$RUN-collector" > "$TMP/collector.log" 2>&1
flushed=$(grep -c 'flushing' "$TMP/collector.log")
saved=$(grep -c 'cursors saved' "$TMP/collector.log")
check "$([ "$flushed" -gt 0 ] && [ "$saved" -gt 0 ] && echo ok)" "shutdown flush is logged" "flushing=$flushed cursors-saved=$saved"
check "$([ "$exit_code" -eq 0 ] && [ "$took" -lt "$STOP_TIMEOUT" ] && echo ok)" "collector exits within the ${STOP_TIMEOUT}s stop timeout" "exit code $exit_code after ${took}s"

if [ "$FAILS" -gt 0 ]; then
	echo "smoke: $FAILS check(s) failed"
	tail -n 15 "$TMP/collector.log"
	exit 1
fi
echo "smoke: all checks passed"
